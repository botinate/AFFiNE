# syntax=docker/dockerfile:1.7
#
# Self-contained build of the AFFiNE server image, so a patch to server code can
# be deployed without reproducing upstream's CI (which builds web, admin,
# mobile, the Rust napi addon and the server in five separate jobs).
#
# Mirrors .github/workflows/build-images.yml step for step.
#
# Must build in Linux containers regardless of host:
#   - the napi addon is OS/arch specific
#   - `engines` pins Node >=22.12 <23 with `engine-strict=true`, so a Node 26
#     host cannot even install the tree
#
# Target arch is parameterised because this is deployed to Apple Silicon hosts
# running a linux/arm64 image. Override for amd64:
#   --build-arg RUST_TARGET=x86_64-unknown-linux-gnu
#   (also drop the YARN_* ARG trap noted in the base stage)

ARG RUST_TARGET=aarch64-unknown-linux-gnu

# ── shared base: node 22 + build toolchain + yarn 4 ───────────────────────
FROM node:22-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl ca-certificates build-essential clang cmake python3 \
      pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /src
COPY . .
# NB: no ARG named YARN_* — Docker promotes ARGs to env vars for RUN steps and
# yarn reads YARN_<name> as a config setting, so `ARG YARN_CPU` makes yarn
# reject an unknown setting called `cpu`. That cost a few build cycles to find.
#
# Single-arch build: yarn's default architecture resolution is the build host,
# which is the target arch here.
RUN yarn install --immutable

# ── server-native.node (Rust napi addon) ──────────────────────────────────
# built-in.json is include_str!-embedded here
# (native/src/llm/prompt_catalog.rs), so any prompt/tool change re-runs this.
FROM base AS native
ARG RUST_TARGET
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain 1.97.1 --profile minimal \
        --target ${RUST_TARGET} --no-modify-path
# tree-sitter needs _BSD_SOURCE and AT_HWCAP2 on aarch64-linux
# (see .github/actions/build-rust/action.yml)
ENV CC="clang -D_BSD_SOURCE -DAT_HWCAP2=26" \
    TARGET_CC="clang -D_BSD_SOURCE -DAT_HWCAP2=26"
# The default release profile OOMs the Docker VM (7.75 GiB) while linking
# affine_server_native — it pulls in llm_adapter, llm_runtime, pdf_oxide and
# sqlx, and LTO + debug info push the link well past that. The host has 48 GiB
# but the VM is the ceiling and cannot be raised from inside a build.
ENV CARGO_PROFILE_RELEASE_LTO=false \
    CARGO_PROFILE_RELEASE_DEBUG=0 \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=256
ARG CARGO_JOBS=4
RUN CARGO_BUILD_JOBS=${CARGO_JOBS} \
    yarn workspace @affine/server-native build --target ${RUST_TARGET}
# native/index.js requires the arch-suffixed name (server-native.arm64.node),
# which is what upstream's CI renames the napi output to. Un-suffixed, rspack
# fails with "Can't resolve './server-native.arm64.node'".
RUN case "${RUST_TARGET}" in \
      aarch64-*) F=server-native.arm64.node ;; \
      armv7-*)   F=server-native.armv7.node ;; \
      *)         F=server-native.x64.node ;; \
    esac \
 && mv ./packages/backend/native/server-native.node \
       "./packages/backend/native/${F}" \
 && ls -la ./packages/backend/native/

# ── frontends ─────────────────────────────────────────────────────────────
FROM base AS frontend
RUN yarn affine @affine/web build \
 && yarn affine @affine/admin build \
 && yarn affine @affine/mobile build

# ── server bundle ─────────────────────────────────────────────────────────
FROM base AS server
ARG RUST_TARGET
COPY --from=native /src/packages/backend/native/ ./packages/backend/native/
RUN case "${RUST_TARGET}" in \
      aarch64-*) F=server-native.arm64.node ;; \
      armv7-*)   F=server-native.armv7.node ;; \
      *)         F=server-native.x64.node ;; \
    esac \
 && echo "expecting ${F}" \
 && ls -la ./packages/backend/native/${F} \
 && yarn workspace @affine/server build

# ── production node_modules + prisma ──────────────────────────────────────
FROM base AS release-deps
COPY --from=server /src/packages/backend/server/dist ./packages/backend/server/dist
COPY --from=frontend /src/packages/frontend/apps/web/dist ./packages/frontend/apps/web/dist
COPY --from=frontend /src/packages/frontend/admin/dist ./packages/frontend/admin/dist
COPY --from=frontend /src/packages/frontend/apps/mobile/dist ./packages/frontend/apps/mobile/dist
RUN yarn workspaces focus @affine/server --production \
 && yarn workspace @affine/server prisma generate \
 && mv ./node_modules ./packages/backend/server

# ── final image (same shape as .github/deployment/node/Dockerfile) ────────
FROM node:22-bookworm-slim AS assets
WORKDIR /app
COPY --from=release-deps /src/packages/backend/server /app
COPY --from=release-deps /src/packages/frontend/apps/web/dist /app/static
COPY --from=release-deps /src/packages/frontend/admin/dist /app/static/admin
COPY --from=release-deps /src/packages/frontend/apps/mobile/dist /app/static/mobile

ARG TARGETARCH
ARG TARGETVARIANT
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN AFFINE_DOCKER_CLEAN=1 TARGETARCH="${TARGETARCH}" TARGETVARIANT="${TARGETVARIANT}" \
    node ./scripts/docker-clean.mjs

FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=assets /app /app
RUN apt-get update && apt-get install -y --no-install-recommends \
      openssl libjemalloc2 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV LD_PRELOAD=libjemalloc.so.2
EXPOSE 3010
CMD ["sh", "-c", "node ./scripts/upgrade-config.js && exec node ./dist/main.js"]
